# Copiá este archivo como ".env" y completá con tus datos reales de Supabase.
# Project Settings -> API en tu proyecto de Supabase.

SUPABASE_URL=https://TU-PROYECTO.supabase.co

# IMPORTANTE: usá la key "service_role" LEGACY (empieza con "eyJ..."), no la
# nueva "sb_secret_...". La librería supabase-py==2.7.4 que usa este proyecto
# es anterior al formato nuevo de keys y no lo reconoce (tira "Invalid API
# key" apenas arranca). La service_role legacy está en Project Settings ->
# API Keys -> pestaña "Legacy anon, service_role API keys".
SUPABASE_KEY=tu-service-role-key-legacy-aca

FLASK_SECRET_KEY=cambiar-esto-por-algo-random
